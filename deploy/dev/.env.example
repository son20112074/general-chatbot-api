# Dev environment config — copy to .env on the server and fill values.

# Application
LOG_LEVEL=DEBUG
BASE_URL=http://<DEV_HOST>:8006/api/v1

# Database (PostgreSQL) — in-container service
# Inside the chatbot-api-dev compose project, reach it via the service name `db`.
# From other compose projects on the shared network (e.g. media-service),
# use `chatbot-db-dev:5432` instead.
DATABASE_URI=postgresql+asyncpg://postgres:postgres@db:5432/api_proxy
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SCHEMA=public

# JWT Auth — MUST match general-chatbot-files JWT_SECRET_KEY
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin role (must match general-chatbot-files ADMIN_ROLE_ID)
ADMIN_ROLE_ID=1

# Redis — in-container service
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CELERY_DB=1

# Storage (MinIO) — shared with general-chatbot-files
STORAGE_PUBLIC_URL=http://<DEV_HOST>/storage
STORAGE_BUCKET_NAME=media-bucket

# LLM
LLM_API=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Optional PaddleOCR-VL vLLM server
# PADDLEOCR_VL_SERVER_URL=

# Content processing
CONTENT_LIMIT=20000

# Legacy / optional
API_KEY=
API_SECRET=
