# API settings
API_KEY=your_api_key_here
API_SECRET=4""
BASE_URL=http://localhost:8000

# Connection settings
REDIS_URL=redis://localhost:6379
MQTT_BROKER_URL=mqtt://localhost:1883
WEBSOCKET_URL=ws://localhost:8080
SOCKET_URL=tcp://localhost:5000

# PaddleOCR-VL (image OCR): optional vLLM server URL to avoid local GPU/CUDA
# Example: https://6780-118-70-233-92.ngrok-free.app or https://your-server.com/v1
# PADDLEOCR_VL_SERVER_URL=https://6780-118-70-233-92.ngrok-free.app

# Logging
LOG_LEVEL=INFO

# Admin role
ADMIN_ROLE_ID=1

# Storage (MinIO)
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET_NAME=media-bucket

# Database settings
DATABASE_URI=postgresql+asyncpg://postgres:Admin123@localhost:5433/postgres
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Topic classification
TOPIC_CLASSIFY_INTERVAL_SECONDS=30
TOPIC_CLASSIFY_BATCH_SIZE=5
TOPIC_CLASSIFY_MAX_RETRIES=3
TOPIC_CLASSIFY_MAX_CONTENT_CHARS=16000
TOPIC_CLASSIFY_PAIR_MAX_RETRIES: int = 3
TOPIC_CLASSIFY_LLM_RATE_LIMIT_RETRIES: int = 3
TOPIC_CLASSIFY_LLM_RATE_LIMIT_MAX_SLEEP_SECONDS: int = 30

LLM_API="https://api.groq.com/openai/v1"
OPENAI_API_KEY=""
LLM_MODEL="llama-3.1-8b-instant"

CONTENT_LIMIT: int = 20000

